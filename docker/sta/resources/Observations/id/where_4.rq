WHERE {
	{
		SELECT DISTINCT ?id ?obs
		$GRAPHS_LIST$
	  	WHERE {
			?obs	rdf:type/rdfs:subClassOf*	sosa:Observation.
			BIND(REPLACE(REPLACE(STRAFTER(STR(?obs), "observation/"), "/", "-"), "%20", "-") AS ?id)
			FILTER(?id = "{id}")
		}
	}
	?obs	sosa:phenomenonTime/time:hasBeginning/time:inXSDDateTimeStamp|sosa:phenomenonTime/time:inXSDDateTimeStamp|sosa:phenomenonTime	?phenomenonTime;
			sosa:resultTime     		?resultTime;
			sosa:hasSimpleResult        ?result.
    BIND(URI(CONCAT('{bare_request_url}')) AS ?self_link)
    BIND(URI(CONCAT('{bare_request_url}/Datastream')) AS ?datastream_link)
    BIND(URI(CONCAT('{bare_request_url}/FeatureOfInterest')) AS ?feature_link)
}
$CODE_0$
