WHERE {
    ?obs    sosa:madeBySensor       ?sensor;
            sosa:observedProperty   ?obs_property;
            sosa:hasResult          ?r.
    BIND(REPLACE(STR(?obs_property), ".*(#|/)", "") AS ?obs_property_name)
    BIND(CONCAT(?obs_property_name) AS ?observed_property_id)
    FILTER(?observed_property_id = "{id}")
}
