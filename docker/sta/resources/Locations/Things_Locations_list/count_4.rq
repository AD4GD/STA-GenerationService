WHERE {
    ?obs    rdf:type/rdfs:subClassOf*   sosa:Observation;
            sosa:hasFeatureOfInterest   ?foi;
            sosa:madeBySensor           ?sensor.
    ?foi    geo:hasGeometry             ?geom.
    ?geom   geo:asWKT                   ?wkt.
    BIND(REPLACE(STR(?sensor), "^.*/([^/]*)$", "$1") AS ?thing_id)
    FILTER(?thing_id = "{id}")
}
