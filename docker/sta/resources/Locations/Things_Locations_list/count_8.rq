WHERE {
    ?col    sosa:madeBySensor           ?sensor;
            sosa:hasMember      		?obs.
    ?obs    sosa:hasFeatureOfInterest   ?foi.
    ?foi    geo:hasGeometry             ?geom.
    ?geom   geo:asWKT                   ?wkt.
    BIND(REPLACE(STR(?sensor), "^.*/([^/]*)$", "$1") AS ?thing_id)
    FILTER(?thing_id = "{id}")
}
