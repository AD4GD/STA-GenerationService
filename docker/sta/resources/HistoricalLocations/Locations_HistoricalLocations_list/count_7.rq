WHERE {
    ?col    sosa:hasFeatureOfInterest   ?foi;
            sosa:hasMember              ?obs.
    ?obs    sosa:resultTime             ?time.
    ?foi    wgs84:lat                   ?raw_lat;
            wgs84:long                  ?raw_long.
    BIND(REPLACE(?raw_lat , "[^0-9.]", "") AS ?lat)
    BIND(REPLACE(?raw_long, "[^0-9.]", "") AS ?long)
    BIND(CONCAT("lat=", ?lat, ":long=", ?long) AS ?locations_id)
    FILTER(?locations_id= "{id}")
}
