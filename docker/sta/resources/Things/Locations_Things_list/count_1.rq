WHERE {
    ?col    rdf:type/rdfs:subClassOf*   sosa:ObservationCollection;
            sosa:hasFeatureOfInterest   ?foi;
            sosa:madeBySensor           ?sensor.
    ?foi    wgs84:lat                   ?raw_lat;
            wgs84:long                  ?raw_long.
    BIND(REPLACE(?raw_lat , "[^0-9.]", "") AS ?lat)
    BIND(REPLACE(?raw_long, "[^0-9.]", "") AS ?long)
    BIND(CONCAT("lat=", ?lat, ":long=", ?long) AS ?location_id)
    FILTER(?location_id = "{id}")
}
